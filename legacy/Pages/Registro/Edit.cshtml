@page
@model FinanzasVineyard.Pages.Registro.EditModel

<h4>Registro</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Registro.Id" />
            <div class="form-group">
                <label asp-for="Registro.IdEntrada" class="control-label"></label>
                <input asp-for="Registro.IdEntrada" class="form-control" />
                <span asp-validation-for="Registro.IdEntrada" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Registro.Nombre" class="control-label"></label>
                <input asp-for="Registro.Nombre" class="form-control" />
                <span asp-validation-for="Registro.Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Registro.Diezmo" class="control-label"></label>
                <input asp-for="Registro.Diezmo" class="form-control" />
                <span asp-validation-for="Registro.Diezmo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Registro.MonedaDiezmo" class="control-label"></label>
                <input asp-for="Registro.MonedaDiezmo" class="form-control" />
                <span asp-validation-for="Registro.MonedaDiezmo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Registro.Ofrenda" class="control-label"></label>
                <input asp-for="Registro.Ofrenda" class="form-control" />
                <span asp-validation-for="Registro.Ofrenda" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Registro.MonedaOfrenda" class="control-label"></label>
                <input asp-for="Registro.MonedaOfrenda" class="form-control" />
                <span asp-validation-for="Registro.MonedaOfrenda" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
