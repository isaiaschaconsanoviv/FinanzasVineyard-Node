@page
@model FinanzasVineyard.Pages.Registro.IndexModel

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Registro[0].IdEntrada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registro[0].Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registro[0].Diezmo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registro[0].MonedaDiezmo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registro[0].Ofrenda)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registro[0].MonedaOfrenda)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Registro) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IdEntrada)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Diezmo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MonedaDiezmo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ofrenda)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MonedaOfrenda)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
