@page "{id:int}"
@model FinanzasVineyard.Pages.OtroRubro.CreateModel

<h4><a style="float:left; margin-right:15px;" class="btn btn-dark" asp-page="../Entrada/Registrar" asp-route-id="@Model.IdEntrada"><i class="fa fa-chevron-left"></i></a> Agregar otro concepto</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input type="hidden" asp-for="OtroRubro.IdRegistro" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="OtroRubro.Tipo" class="control-label"></label>
                <input asp-for="OtroRubro.Tipo" class="form-control" />
                <span asp-validation-for="OtroRubro.Tipo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label asp-for="OtroRubro.Importe" class="control-label"></label>
                        <input asp-for="OtroRubro.Importe" class="form-control" />
                        <span asp-validation-for="OtroRubro.Importe" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="OtroRubro.Moneda" class="control-label"></label>
                        <select asp-for="OtroRubro.Moneda" class="form-control" >
                            <option value="MXN">MXN</option>
                            <option value="USD">USD</option>
                        </select>
                        <span asp-validation-for="OtroRubro.Moneda" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <br />
            <div class="form-group">
                <div class="row">
                    <div style="float:right;" class="col-md-12">
                        @*<input type="submit" value="Create" class="btn btn-primary" />*@
                        <button style="float:right;" class="btn btn-primary" onclick="this.form.submit"><i class="fa fa-plus"></i> Agregar</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
