@page
@model FinanzasVineyard.Pages.Entrada.DeleteModel

<h3><a class="btn btn-dark" asp-page="./Index"><i class="fa fa-chevron-left"></i></a> Estas seguro(a) de querer borrar esta entrada y todos los registros relacionados con ella?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Entrada.Fecha)
        </dt>
        <dd class="col-sm-10">
            @Model.Entrada.Fecha.ToString("D")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Entrada.TipoCambio)
        </dt>
        <dd class="col-sm-10">
            @Model.Entrada.TipoCambio.ToString("C2") MXN
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Entrada.ElaboradoPor)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Entrada.ElaboradoPor)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Entrada.Notas)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Entrada.Notas)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Entrada.Id" />
        <button type="submit" class="btn btn-danger"><i class="fa fa-trash-can"></i> Eliminar</button>
    </form>
</div>
