@page
@model FinanzasVineyard.Pages.Entrada.CreateModel
@{
    ViewData["Title"] = "Nueva Entrada";
}

<h4><a class="btn btn-dark" asp-page="Index"><i class="fa fa-chevron-left"></i></a> Nueva Entrada</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Entrada.Fecha" class="control-label"></label>
                <input asp-for="Entrada.Fecha" type="date" class="form-control" />
                <span asp-validation-for="Entrada.Fecha" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Entrada.TipoCambio" class="control-label"></label>
                <input asp-for="Entrada.TipoCambio" class="form-control" />
                <span asp-validation-for="Entrada.TipoCambio" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="Entrada.ElaboradoPor" class="control-label"></label>
                <input asp-for="Entrada.ElaboradoPor" class="form-control" />
                <span asp-validation-for="Entrada.ElaboradoPor" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <center><input type="submit" value="Guardar y continuar" class="btn btn-primary" /></center>
            </div>
        </form>
    </div>
</div>
<br />
<br />
<div>
    
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
